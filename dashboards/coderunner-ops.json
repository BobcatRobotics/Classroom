{
	"title": "CodeRunner — Ops",
	"uid": "coderunner-ops",
	"description": "Single ops dashboard for retroactive session review: was the VM big enough, how did runs go, and what went wrong. Set the time range to cover the class session you want to review.",
	"tags": ["frc-sim", "overview"],
	"schemaVersion": 38,
	"version": 1,
	"editable": true,
	"refresh": "1m",
	"time": { "from": "now-6h", "to": "now" },
	"timepicker": {},
	"templating": {
		"list": [
			{
				"name": "datasource",
				"type": "datasource",
				"query": "prometheus",
				"label": "Metrics",
				"hide": 0,
				"refresh": 1,
				"current": {}
			},
			{
				"name": "logs",
				"type": "datasource",
				"query": "loki",
				"label": "Logs",
				"hide": 0,
				"refresh": 1,
				"current": {}
			}
		]
	},
	"panels": [
		{
			"id": 100,
			"type": "row",
			"title": "Host VM",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
			"collapsed": false,
			"panels": []
		},
		{
			"id": 1,
			"type": "timeseries",
			"title": "Host CPU busy %",
			"gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
					"legendFormat": "CPU busy",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"min": 0,
					"max": 100,
					"custom": { "fillOpacity": 10, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "showLegend": false },
				"tooltip": { "mode": "single" }
			}
		},
		{
			"id": 2,
			"type": "timeseries",
			"title": "Host memory used %",
			"gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
					"legendFormat": "memory used",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"min": 0,
					"max": 100,
					"custom": { "fillOpacity": 10, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "showLegend": false },
				"tooltip": { "mode": "single" }
			}
		},
		{
			"id": 3,
			"type": "timeseries",
			"title": "Disk used %",
			"gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "100 * (1 - node_filesystem_avail_bytes{fstype=\"ext4\", mountpoint=~\"/|/var/lib/coderunner/data\"} / node_filesystem_size_bytes{fstype=\"ext4\", mountpoint=~\"/|/var/lib/coderunner/data\"})",
					"legendFormat": "{{mountpoint}}",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"min": 0,
					"max": 100,
					"custom": {
						"fillOpacity": 10,
						"lineWidth": 2,
						"thresholdsStyle": { "mode": "line" }
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "red", "value": 85 }
						]
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"showLegend": true,
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi" }
			}
		},
		{
			"id": 4,
			"type": "timeseries",
			"title": "Network I/O (host NIC)",
			"gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum(rate(node_network_receive_bytes_total{device=~\"ens.*|eth.*\"}[$__rate_interval]))",
					"legendFormat": "in",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				},
				{
					"refId": "B",
					"expr": "sum(rate(node_network_transmit_bytes_total{device=~\"ens.*|eth.*\"}[$__rate_interval]))",
					"legendFormat": "out",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "Bps",
					"min": 0,
					"custom": { "fillOpacity": 10, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"showLegend": true,
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi" }
			}
		},
		{
			"id": 101,
			"type": "row",
			"title": "Workspaces",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
			"collapsed": false,
			"panels": []
		},
		{
			"id": 5,
			"type": "timeseries",
			"title": "Active workspaces",
			"gridPos": { "h": 8, "w": 4, "x": 0, "y": 10 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "active_workspaces",
					"legendFormat": "active",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"decimals": 0,
					"custom": { "fillOpacity": 20, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "showLegend": false },
				"tooltip": { "mode": "single" }
			}
		},
		{
			"id": 6,
			"type": "timeseries",
			"title": "CPU % per workspace",
			"gridPos": { "h": 8, "w": 8, "x": 4, "y": 10 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "container_cpu_percent",
					"legendFormat": "{{workspace_id}}",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"min": 0,
					"custom": { "fillOpacity": 0, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"showLegend": true,
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			}
		},
		{
			"id": 7,
			"type": "timeseries",
			"title": "Memory % per workspace",
			"gridPos": { "h": 8, "w": 8, "x": 12, "y": 10 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "container_memory_percent",
					"legendFormat": "{{workspace_id}}",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"min": 0,
					"max": 100,
					"custom": {
						"fillOpacity": 0,
						"lineWidth": 2,
						"thresholdsStyle": { "mode": "line" }
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "red", "value": 80 }
						]
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"showLegend": true,
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			}
		},
		{
			"id": 8,
			"type": "timeseries",
			"title": "Container cold-start p95",
			"gridPos": { "h": 8, "w": 4, "x": 20, "y": 10 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "histogram_quantile(0.95, sum by (le) (rate(container_start_duration_seconds_bucket[15m])))",
					"legendFormat": "p95",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"min": 0,
					"custom": { "fillOpacity": 10, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "showLegend": false },
				"tooltip": { "mode": "single" }
			}
		},
		{
			"id": 102,
			"type": "row",
			"title": "Runs",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
			"collapsed": false,
			"panels": []
		},
		{
			"id": 9,
			"type": "timeseries",
			"title": "Runs by terminal status (15m buckets)",
			"gridPos": { "h": 8, "w": 10, "x": 0, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (terminal_status) (increase(runs_total[15m]))",
					"legendFormat": "{{terminal_status}}",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"decimals": 0,
					"custom": {
						"drawStyle": "bars",
						"fillOpacity": 60,
						"lineWidth": 1,
						"stacking": { "mode": "normal" }
					}
				},
				"overrides": [
					{
						"matcher": { "id": "byName", "options": "stopped" },
						"properties": [
							{
								"id": "color",
								"value": { "mode": "fixed", "fixedColor": "green" }
							}
						]
					},
					{
						"matcher": { "id": "byName", "options": "failed" },
						"properties": [
							{
								"id": "color",
								"value": { "mode": "fixed", "fixedColor": "red" }
							}
						]
					},
					{
						"matcher": { "id": "byName", "options": "canceled" },
						"properties": [
							{
								"id": "color",
								"value": { "mode": "fixed", "fixedColor": "orange" }
							}
						]
					}
				]
			},
			"options": {
				"legend": {
					"showLegend": true,
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi" }
			}
		},
		{
			"id": 10,
			"type": "timeseries",
			"title": "Build duration (queue → sim-ready)",
			"gridPos": { "h": 8, "w": 8, "x": 10, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "histogram_quantile(0.50, sum by (le) (rate(run_build_duration_seconds_bucket[15m])))",
					"legendFormat": "p50",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				},
				{
					"refId": "B",
					"expr": "histogram_quantile(0.95, sum by (le) (rate(run_build_duration_seconds_bucket[15m])))",
					"legendFormat": "p95",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"min": 0,
					"custom": { "fillOpacity": 10, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"showLegend": true,
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi" }
			}
		},
		{
			"id": 11,
			"type": "stat",
			"title": "Runs (time range)",
			"gridPos": { "h": 4, "w": 3, "x": 18, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum(increase(runs_total[$__range])) or vector(0)",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": { "unit": "short", "decimals": 0 },
				"overrides": []
			},
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"colorMode": "value",
				"graphMode": "none"
			}
		},
		{
			"id": 12,
			"type": "stat",
			"title": "Failed runs (time range)",
			"gridPos": { "h": 4, "w": 3, "x": 21, "y": 19 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum(increase(runs_total{terminal_status=\"failed\"}[$__range])) or vector(0)",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "red", "value": 1 }
						]
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"colorMode": "value",
				"graphMode": "none"
			}
		},
		{
			"id": 13,
			"type": "stat",
			"title": "Idle-sweep stops (time range)",
			"gridPos": { "h": 4, "w": 6, "x": 18, "y": 23 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum(increase(idle_sweep_stops_total[$__range])) or vector(0)",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": { "unit": "short", "decimals": 0 },
				"overrides": []
			},
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"colorMode": "value",
				"graphMode": "none"
			}
		},
		{
			"id": 103,
			"type": "row",
			"title": "Control plane",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
			"collapsed": false,
			"panels": []
		},
		{
			"id": 14,
			"type": "timeseries",
			"title": "Request rate by route",
			"gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (route) (rate(http_request_duration_seconds_count[$__rate_interval]))",
					"legendFormat": "{{route}}",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "reqps",
					"min": 0,
					"custom": { "fillOpacity": 0, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"showLegend": true,
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			}
		},
		{
			"id": 15,
			"type": "timeseries",
			"title": "5xx responses (15m buckets)",
			"gridPos": { "h": 8, "w": 4, "x": 8, "y": 28 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum(increase(http_request_duration_seconds_count{status_class=\"5xx\"}[15m]))",
					"legendFormat": "5xx",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"min": 0,
					"decimals": 0,
					"color": { "mode": "fixed", "fixedColor": "red" },
					"custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "showLegend": false },
				"tooltip": { "mode": "single" }
			}
		},
		{
			"id": 16,
			"type": "timeseries",
			"title": "p95 latency",
			"gridPos": { "h": 8, "w": 6, "x": 12, "y": 28 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[15m])))",
					"legendFormat": "HTTP overall",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				},
				{
					"refId": "B",
					"expr": "histogram_quantile(0.95, sum by (le) (rate(proxy_upstream_duration_seconds_bucket{upstream=\"vscode\"}[15m])))",
					"legendFormat": "editor proxy",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"min": 0,
					"custom": { "fillOpacity": 0, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"showLegend": true,
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": { "mode": "multi" }
			}
		},
		{
			"id": 17,
			"type": "timeseries",
			"title": "Event-loop lag p99",
			"gridPos": { "h": 8, "w": 3, "x": 18, "y": 28 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "nodejs_eventloop_lag_p99_seconds",
					"legendFormat": "lag p99",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"min": 0,
					"custom": { "fillOpacity": 10, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "showLegend": false },
				"tooltip": { "mode": "single" }
			}
		},
		{
			"id": 18,
			"type": "timeseries",
			"title": "Control-plane RSS",
			"gridPos": { "h": 8, "w": 3, "x": 21, "y": 28 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"refId": "A",
					"expr": "process_resident_memory_bytes",
					"legendFormat": "RSS",
					"datasource": { "type": "prometheus", "uid": "${datasource}" }
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "bytes",
					"min": 0,
					"custom": { "fillOpacity": 10, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "showLegend": false },
				"tooltip": { "mode": "single" }
			}
		},
		{
			"id": 104,
			"type": "row",
			"title": "Recent warnings & errors",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
			"collapsed": false,
			"panels": []
		},
		{
			"id": 19,
			"type": "logs",
			"title": "Control-plane warnings & errors",
			"gridPos": { "h": 10, "w": 24, "x": 0, "y": 37 },
			"datasource": { "type": "loki", "uid": "${logs}" },
			"targets": [
				{
					"refId": "A",
					"expr": "{job=\"coderunner\", level=~\"warn|warning|error|critical\"}",
					"datasource": { "type": "loki", "uid": "${logs}" }
				}
			],
			"options": {
				"showTime": true,
				"showLabels": false,
				"showCommonLabels": false,
				"wrapLogMessage": true,
				"prettifyLogMessage": false,
				"enableLogDetails": true,
				"dedupStrategy": "none",
				"sortOrder": "Descending"
			}
		}
	]
}
