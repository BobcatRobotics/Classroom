# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts and gradle wrapper must keep LF for Linux/Docker
*.sh text eol=lf
gradlew text eol=lf
Dockerfile text eol=lf
entrypoint.sh text eol=lf

# Patch files must keep LF — git apply rejects CRLF blank context lines
# ("corrupt patch at line N") when checked out on Windows with autocrlf.
*.patch text eol=lf

# Container root filesystems are COPYed byte-for-byte into Linux images;
# CRLF in an s6 run script's shebang or a type/up file breaks the container.
containers/*/root/** text eol=lf
